# Copy to .env and fill in. The .env is in .gitignore and stays on this
# machine: the repository is public. Whatever the environment already has
# wins over this file.
#
#     cp .env.example .env

# The Neon database. Use the DIRECT connection string (not the -pooler one)
# and edit it by hand: sslmode=verify-full, and drop channel_binding. The
# one Neon gives you says sslmode=require, which pg accepts with a
# deprecation warning. For local work, a Neon branch (e.g. «dev») keeps test
# requests out of the real table.
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full

# The server's port and address. 127.0.0.1 (the default) keeps it on this
# machine; HOST=0.0.0.0 opens it to the network, e.g. to test from a phone.
# PORT=3000
# HOST=127.0.0.1

# How many stored forms one address may send in 24 h.
# CIPRESSINA_FORMS_DAILY_IP=30

# A custom domain, once there is one: accepted as this site's Origin on
# POST /api/requests (the onrender.com host already is).
# CIPRESSINA_SITE_URL=https://preventivi.example.it
